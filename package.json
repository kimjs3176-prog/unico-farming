{
  "name": "unico-farming",
  "version": "0.1.0",
  "description": "유니코(UNICO) 농업 메타버스 - 캐주얼 3D 농장 게임",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress-models.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "models": "python3 blender/build_all.py",
    "test": "node --test",
    "models:compress": "node scripts/compress-models.mjs"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "three": "^0.182.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "vite": "^7.1.0"
  }
}
